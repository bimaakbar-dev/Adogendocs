---
// src/components/Footer.astro
import { SITE, NAV } from "@/consts";
import Socials from "./Socials.astro";
import Container from "./ui/Container.astro";

const currentYear = new Date().getFullYear();

const copyrightYear =
  currentYear > SITE.foundingYear
    ? `${SITE.foundingYear}–${currentYear}`
    : SITE.foundingYear;
---

<footer class="mt-auto shrink-0 border-t border-(--border-subtle)/40 py-8 px-4">
  <Container size="full">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
      { NAV.footerBar.map((section) => (
          <div>
            <h3 class="mb-4 text-body-14 font-semibold uppercase font-mono text-(--fg-strong)">
              {section.title}
            </h3>
            <ul class="space-y-2">
              {section.items.map((item) => (
                <li>
                  <a href={item.href}
                    class="text-body-14 text-(--fg-muted) font-medium hover:text-(--fg-strong) active:text-(--fg-strong)">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        
      </div>
    </div>
    <div class="flex-col-reverse sm:flex justify-between mt-8 border-t border-(--border)/40 pt-6 gap-4 items-center text-center text-[13px] text-(--fg-muted)/60">
      &copy; {copyrightYear} {SITE.name}
      <div class="items-center gap-4 hidden">
        <Socials />
      </div>
    </div>
  </Container>
</footer>
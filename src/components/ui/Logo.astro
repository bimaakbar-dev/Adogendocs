---
//src/ui/Logo.astro
import { 
    SITE, 
    ROUTES 
} from "@/consts";

import Button from "./Button.astro";
import Icon from "./Icons.astro";

interface Props {
  label?: boolean;
}

const { 
    label = true 
} = Astro.props;

const $ = {
    wrapper: "p-0! hover:bg-transparent! active:bg-transparent!",
    logo: "size-6",
    label: "text-heading-20 font-semibold text-(--fg-strong)"
}
---
<Button
    href={ROUTES.home}
    aria-label={SITE.name}
    variant="ghost"
    size="lg"
    class={$.wrapper}>
    <Icon name="logo" class={$.logo} />
    {label && ( 
        <span class={$.label}>
            {SITE.name}
        </span> 
    )}
    <br />
</Button>

---
// src/pages/agent.astro
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import Icons from "@/components/ui/Icons.astro";
import {
    SITE,
    buildMeta
} from "@/consts";

const pageParam = Astro.url.searchParams.get("page") || "";

const meta = buildMeta({
  title: "AI Agent",
  description: "Eksplorasi dokumentasi, artikel, dan kode teknikal Codocs lewat obrolan AI.",
  canonical: `${SITE.url}/agent`,
  noindex: true,
});
---

<Layout meta={meta}>
  <main class="max-w-3xl mx-auto px-4 py-10 min-h-[80vh] flex flex-col">

    <!-- Header Halaman Agent -->
    <div class="mb-6 pb-4 border-b border-(--border-subtle)">
      <div class="flex items-center gap-2">
        <div class="relative flex size-8 items-center justify-center rounded-lg bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong)">
          <span class="absolute inset-0 rounded-lg bg-(--accent) opacity-15 blur-md"></span>
          <Icons name="ai-agent" class="relative size-5 text-(--accent)" />
        </div>
        <div>
          <h1 class="text-heading-16 font-semibold text-(--fg-strong)">Codocs AI Agent</h1>
          <p class="text-xs text-(--fg-muted)">Eksplorasi dokumentasi, artikel, dan kode teknikal melalui obrolan cerdas.</p>
        </div>
      </div>
      {pageParam && (
        <div class="mt-3 inline-flex items-center gap-2 px-2.5 py-1 text-xs rounded-md bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-muted)">
          <span>Konteks aktif halaman:</span>
          <code class="text-(--fg-strong) font-mono">{pageParam}</code>
        </div>
      )}
    </div>

    <div id="agent-chat-container" class="agent-scroll flex-1 overflow-y-auto space-y-4 mb-6 pr-2 text-sm max-h-[60vh]">
      <div class="flex gap-3 items-start">
        <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong)">
          <Icons name="ask-ai" class="size-4" />
        </div>
        <div class="p-3.5 rounded-2xl rounded-tl-sm bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-muted) max-w-[85%] leading-relaxed">
          Halo! Saya adalah AI Agent Anda. Silakan ajukan pertanyaan atau minta rangkuman mengenai materi teknikal di situs ini.
        </div>
      </div>
    </div>

    <!-- Form Input & Tombol Kirim di Bawah -->
    <div class="agent-input-bar flex items-end gap-2 pt-3 border-t border-(--border-subtle) bg-(--bg)">
      <textarea
        id="agent-input"
        rows="1"
        placeholder="Ketik pertanyaan atau instruksi untuk AI..."
        class="agent-textarea flex-1 resize-none rounded-xl border border-(--border-subtle) bg-(--bg-subtle) px-3 py-2 text-sm text-(--fg-strong) placeholder:text-(--fg-muted) outline-none transition-[border-color,box-shadow] focus:border-(--accent) focus:shadow-[0_0_0_3px_var(--accent-a20,rgba(59,130,246,.15))]"
      ></textarea>
      <Button
        id="agent-submit"
        variant="primary"
        size="md"
        thisIcon
        class="agent-send-btn shrink-0"
        disabled
        aria-label="Kirim pertanyaan"
      >
        <Icons name="ask-ai" class="agent-send-icon size-4" />
        <span class="agent-send-spinner"></span>
      </Button>
    </div>

  </main>
</Layout>

<template id="template-msg-user">
  <div class="flex gap-3 justify-end items-start agent-msg-in">
    <div class="p-3.5 rounded-2xl rounded-tr-sm bg-(--accent) text-(--accent-fg) max-w-[85%] whitespace-pre-wrap leading-relaxed shadow-sm"></div>
  </div>
</template>

<template id="template-msg-ai">
  <div class="flex gap-3 justify-start items-start agent-msg-in group">
    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong)">
      <Icons name="ask-ai" class="size-4" />
    </div>
    <div class="relative max-w-[85%]">
      <div data-ai-text class="p-3.5 rounded-2xl rounded-tl-sm bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong) whitespace-pre-wrap leading-relaxed"></div>
      <button
        data-ai-copy
        type="button"
        aria-label="Salin jawaban"
        class="agent-copy-btn absolute -bottom-2 right-1 opacity-0 group-hover:opacity-100 focus-visible:opacity-100"
      >
        <Icons name="ask-ai" class="size-3" />
      </button>
    </div>
  </div>
</template>

<template id="template-msg-typing">
  <div class="flex gap-3 justify-start items-start agent-msg-in">
    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong)">
      <Icons name="ask-ai" class="size-4" />
    </div>
    <div class="agent-typing p-3.5 rounded-2xl rounded-tl-sm bg-(--bg-subtle) border border-(--border-subtle)">
      <span></span><span></span><span></span>
    </div>
  </div>
</template>

<style>
  .agent-scroll {
    scroll-behavior: smooth;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 12px, black calc(100% - 12px), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, black 12px, black calc(100% - 12px), transparent 100%);
  }

  @keyframes agent-msg-in {
    from { opacity: 0; transform: translateY(6px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .agent-msg-in {
    animation: agent-msg-in 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .agent-typing {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .agent-typing span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--fg-muted);
    opacity: 0.5;
    animation: agent-typing-bounce 1.1s ease-in-out infinite;
  }
  .agent-typing span:nth-child(2) { animation-delay: 0.15s; }
  .agent-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes agent-typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .agent-textarea {
    max-height: calc(1.4em * 6 + 1rem);
    line-height: 1.4;
    overflow-y: auto;
  }

  .agent-send-btn {
    position: relative;
  }
  .agent-send-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .agent-send-icon {
    transition: opacity 0.15s ease;
  }
  .agent-send-spinner {
    display: none;
    position: absolute;
    inset: 0;
    margin: auto;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 2px solid color-mix(in srgb, var(--fg-strong) 30%, transparent);
    border-top-color: var(--fg-strong);
  }
  .agent-send-btn.is-loading .agent-send-icon { opacity: 0; }
  .agent-send-btn.is-loading .agent-send-spinner {
    display: block;
    animation: agent-spin 0.7s linear infinite;
  }
  @keyframes agent-spin {
    to { transform: rotate(360deg); }
  }

  .agent-copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--fg-muted);
    transition: opacity 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .agent-copy-btn:hover {
    color: var(--fg-strong);
    transform: scale(1.08);
  }
  .agent-copy-btn.copied {
    color: var(--accent);
  }

  [data-ai-text].is-error {
    color: var(--fg-muted);
  }
</style>

<script>
  const submitBtn = document.getElementById('agent-submit') as HTMLButtonElement;
  const inputEl = document.getElementById('agent-input') as HTMLTextAreaElement;
  const chatContainer = document.getElementById('agent-chat-container');

  const tmplUser = document.getElementById('template-msg-user') as HTMLTemplateElement;
  const tmplAi = document.getElementById('template-msg-ai') as HTMLTemplateElement;
  const tmplTyping = document.getElementById('template-msg-typing') as HTMLTemplateElement;

  function scrollToBottom() {
    chatContainer?.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
  }

  function appendUserMessage(text: string) {
    const clone = tmplUser.content.cloneNode(true) as DocumentFragment;
    const bubble = clone.querySelector('div > div') as HTMLElement;
    if (bubble) bubble.textContent = text;
    chatContainer?.appendChild(clone);
    scrollToBottom();
  }

  function appendTypingIndicator() {
    const clone = tmplTyping.content.cloneNode(true) as DocumentFragment;
    const node = clone.firstElementChild as HTMLElement;
    chatContainer?.appendChild(clone);
    scrollToBottom();
    return node;
  }

  function appendAiMessage(text: string, isError = false) {
    const clone = tmplAi.content.cloneNode(true) as DocumentFragment;
    const bubble = clone.querySelector('[data-ai-text]') as HTMLElement;
    const copyBtn = clone.querySelector('[data-ai-copy]') as HTMLButtonElement;

    if (bubble) {
      bubble.textContent = text;
      bubble.classList.toggle('is-error', isError);
    }

    if (copyBtn) {
      if (isError) {
        copyBtn.remove();
      } else {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add('copied');
            setTimeout(() => copyBtn.classList.remove('copied'), 1200);
          } catch {
            // clipboard unavailable — silently ignore
          }
        });
      }
    }

    chatContainer?.appendChild(clone);
    scrollToBottom();
  }

  function autosize() {
    inputEl.style.height = 'auto';
    inputEl.style.height = `${inputEl.scrollHeight}px`;
  }

  function updateSendState() {
    submitBtn.disabled = inputEl.value.trim().length === 0;
  }

  function setLoading(loading: boolean) {
    submitBtn.classList.toggle('is-loading', loading);
    submitBtn.disabled = loading || inputEl.value.trim().length === 0;
    inputEl.disabled = loading;
  }

  // Auto-isi jika ada parameter URL ?page=... saat pertama kali halaman dibuka
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const pageTarget = urlParams.get('page');
    if (pageTarget && inputEl) {
      inputEl.value = `Tolong jelaskan isi dari halaman ${pageTarget}`;
      autosize();
      updateSendState();
    }
  });

  async function handleAgentAsk() {
    const question = inputEl.value.trim();
    if (!question) return;

    inputEl.value = '';
    autosize();
    updateSendState();
    setLoading(true);

    appendUserMessage(question);
    const typingNode = appendTypingIndicator();

    const context = document.querySelector('article')?.innerText || window.location.pathname;

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, context }),
      });
      const data = await res.json();
      typingNode?.remove();
      appendAiMessage(data.answer || 'Tidak ada respons.');
    } catch {
      typingNode?.remove();
      appendAiMessage('Gagal menghubungi server AI. Coba lagi sebentar lagi.', true);
    } finally {
      setLoading(false);
      inputEl?.focus();
    }
  }

  submitBtn?.addEventListener('click', handleAgentAsk);
  inputEl?.addEventListener('input', () => {
    autosize();
    updateSendState();
  });
  inputEl?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleAgentAsk();
    }
  });
</script>
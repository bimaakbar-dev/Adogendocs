---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import {
  buildMeta,
  ROUTES,
  SITE,
} from "@/consts";

import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import Hero from "@/components/Hero.astro";
import LatestBlog from '@/components/blog/BlogLatest.astro';
import Button from '@/components/ui/Button.astro';
import Icons from '@/components/ui/Icons.astro';
import HeroImage from '@/assets/images/houston.webp';

const allBlog = await getCollection('blog');

const latestBlog = allBlog
  .sort((a, b) => {
    const dateA = a.data.pubDate || new Date(0);
    const dateB = b.data.pubDate || new Date(0);
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 6);

const meta = buildMeta({
  description: SITE.description,
  canonical: SITE.url,
  ogType: "website",
  keywords: [],
});
---

<Layout {meta} isHome>
  <div class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)">
    <Container size="xl">
      <Section size="sm">
        <Hero 
          image={HeroImage}
          title={SITE.description}
          action={ROUTES.docs}
          actionLabel='Get Started'
          action2={ROUTES.blog}
          actionLabel2='Baca Blog' />
      </Section>
    </Container>
    <Container size="xl">
      <Section size="sm">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-heading-24 font-semibold text-(--fg-strong)">
            Terbaru.
          </h2>
          <Button
            href="/blog"
            variant='ghost'
            size='md'
            suffix={<Icons name="arrow-right" class='size-4.5'/>}
            class="text-sm"
          >
            Lihat Semua
          </Button>
        </div>
        <LatestBlog items={latestBlog} />
      </Section>
    </Container>
  </div>
</Layout>

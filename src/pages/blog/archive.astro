---
import { getCollection, type CollectionEntry } from 'astro:content';
import { buildMeta } from "@/consts";

import Layout from '@/layouts/Layout.astro';
import Section from "@/components/ui/Section.astro";
import Container from '@/components/ui/Container.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Card from '@ui/Card.astro';
import Button from '@ui/Button.astro';

type BlogEntry = CollectionEntry<'blog'>;

const allPosts: BlogEntry[] = await getCollection('blog', ({ data }) => !data.draft);

const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.pubDate ?? new Date(0);
  const dateB = b.data.pubDate ?? new Date(0);
  return dateB.getTime() - dateA.getTime();
});

const formatMonthName = (monthIndex: number) => {
  return new Intl.DateTimeFormat('id-ID', { month: 'long' }).format(new Date(2000, monthIndex, 1));
};

const formatDate = (date?: Date) => {
  if (!date) return '';
  return new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short' }).format(date);
};

type GroupedArchive = Record<number, Record<number, BlogEntry[]>>;

const archive = sortedPosts.reduce<GroupedArchive>((acc, post) => {
  const date = post.data.pubDate ?? new Date(0);
  const year = date.getFullYear();
  const month = date.getMonth();

  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];

  acc[year][month].push(post);
  return acc;
}, {});

const years = Object.keys(archive).map(Number).sort((a, b) => b - a);

const currentPath = Astro.url.pathname;

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Archive", href: currentPath },
];

const meta = buildMeta({
  title: "Archive",
  description: "Arsip lengkap seluruh artikel blog berdasarkan tahun dan bulan terbit.",
  canonical: currentPath,
  ogType: "website",
  keywords: ["arsip blog", "blog archive"],
});
---

<Layout {meta}>
  <Section size="md">
    <Container size="lg">
      <Section size="sm">
        <Breadcrumb separator="chevron" items={breadcrumbItems} />
      </Section>
      <Section size="sm">
        <h1 class="text-heading-32 md:text-heading-40 font-semibold tracking-tight leading-tight text-balance text-(--fg-strong)">Archive</h1>
      </Section>
      <Section size="sm">
        <Card padding='md' radius='sm' variant='secondary' class="flex flex-wrap gap-2 mb-8">
          <span class="text-label-14 font-medium text-(--fg) self-center mr-2">Pilih Tahun:</span>
          {years.map((year) => (
            <Button
              href={`#year-${year}`}
              variant='secondary'
              size='sm'>
              {year}
            </Button>
          ))}
        </Card>
      </Section>
      <Section size="none">
        <div class="space-y-6">
          {years.map((year) => (
            <div id={`year-${year}`} class="scroll-mt-(--scroll-padding)">
              <h2 class="text-heading-24 md:text-heading-32 font-semibold text-(--fg-strong) pb-2 mb-4">
                {year}
              </h2>
              <div class="space-y-6">
                {Object.keys(archive[year])
                  .map(Number)
                  .sort((a, b) => b - a)
                  .map((month) => (
                    <div class="p-0">
                      <h3 class="text-sm font-medium text-(--fg) mb-3">
                        {formatMonthName(month)} ({archive[year][month].length})
                      </h3>

                      <ul class="space-y-2 pl-3 border-l border-(--border-subtle)">
                        {archive[year][month].map((post) => {
                          const slug = post.data.slug ?? post.id;
                          return (
                            <li class="flex items-center justify-between group p-1.5 rounded">
                              <a
                                href={`/blog/${slug}`}
                                class="text-sm text-(--fg-muted) group-hover:text-(--fg-strong) line-clamp-1 pr-4"
                              >
                                {post.data.title}
                              </a>
                              <time class="text-xs! text-(--fg-muted) whitespace-nowrap shrink-0">
                                {formatDate(post.data.pubDate)}
                              </time>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  ))}
              </div>
            </div>
          ))}
        </div>
      </Section>
    </Container>
  </Section>
</Layout>
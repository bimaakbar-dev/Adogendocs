---
// src/layouts/Layout.astro
import Page from "@/components/Page.astro";
import Alert from "@/components/ui/Alert.astro";
import Search from "@components/Search.astro";
import Drawer from "@/components/ui/Drawer.astro";
import AiAsk from "@/components/AiAsk.astro";
import { SITE, type buildMeta as BuildMetaFn } from "@/consts";

import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import SkipLink from "@components/SkipLink.astro";
import ThemeProvider from "@components/ThemeProvider.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  meta?: Partial<ReturnType<typeof BuildMetaFn>>;
  schema?: object | object[];
  isHome?: boolean;
  canonical?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  meta,
  schema,
  isHome = false,
  canonical,
  hideHeader = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
  <Head {meta} {schema} {isHome} {canonical}>
    <ThemeProvider />
  </Head>
  <body>
    <SkipLink />
    <Search />
    <Drawer id="ai-assistant-drawer">
      <AiAsk />
    </Drawer>
    <Page>
      {!hideHeader && <Header />}
      <!--<Alert
        message="Selamat datang di c0desk1"
        actionLabel="Learn how to use"
        actionHref="/docs"
      />-->
      <slot />
      {!hideFooter && <Footer />}
    </Page>
  </body>
</html>
